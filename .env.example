# Copy this file to .env and fill in the values. Never commit .env.
OPENAI_API_KEY=
UMLS_API_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
# fake or dense. Dense needs the ingested database and the ML packages.
RETRIEVER_MODE=fake
# stub or openai. Openai spends money.
LLM_MODE=stub

#Specify the reranking mode. Options are "off" or "crossencoder". Crossencoder requires the ingested database and the ML packages.
RERANK_MODE=off
RERANK_CANDIDATES=20
RERANK_TOP_K=5
